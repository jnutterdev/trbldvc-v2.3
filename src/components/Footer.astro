---
import siteSettings from '../content/siteSettings/index.json';
---
<div class="footer-bar">
  <span class="footer-copy">
    &copy; {siteSettings.copyright_start_year}–{new Date().getFullYear()} terribledevice.com &mdash; {siteSettings.tagline}
  </span>
  <div class="footer-social">
    {siteSettings.social?.map(link => (
      <a
        rel="me"
        href={link.url}
        class="social-link"
        target={link.url?.startsWith('mailto:') ? undefined : '_blank'}
        rel={link.url?.startsWith('mailto:') ? undefined : 'noopener'}
        aria-label={link.platform}
      >
        <i class={link.icon}></i>
      </a>
    ))}
  </div>
  <span class="footer-sig">&#x25A0; end transmission</span>
</div>
